# ---------------------------------------------------------------------------
# Banco de dados (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Use a connection string do endpoint POOLED do Neon (o host contém "-pooler").
# Painel do Neon > Project > Connect > Connection string.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Opcional. Força o driver de acesso ao banco.
#   neon     -> driver HTTP do Neon (padrão para qualquer host remoto)
#   postgres -> driver nativo (padrão para localhost, útil em desenvolvimento)
# DATABASE_DRIVER="neon"

# ---------------------------------------------------------------------------
# Painel administrativo (/admin)
# ---------------------------------------------------------------------------
# Usuário do painel. Opcional; o padrão é "admin".
ADMIN_USERNAME="admin"

# Senha do painel. Use uma senha longa e exclusiva.
ADMIN_PASSWORD="troque-esta-senha"

# Chave usada para assinar o cookie de sessão. Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 48
SESSION_SECRET="troque-esta-chave-por-uma-string-aleatoria-longa"

# ---------------------------------------------------------------------------
# Evento (opcional)
# ---------------------------------------------------------------------------
# Data e hora do evento em ISO 8601 com fuso. Usado pela contagem regressiva.
# NEXT_PUBLIC_EVENT_DATE="2026-10-10T14:30:00-03:00"
